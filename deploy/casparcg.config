<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <paths>
        <media-path>media/</media-path>
        <log-path disable="false">log/</log-path>
        <data-path>data/</data-path>
        <template-path>template/</template-path>
    </paths>
    <lock-clear-phrase>secret</lock-clear-phrase>
    <channels>
        <channel>
            <video-mode>720p5000</video-mode>
            <consumers>
                <screen />
                <system-audio />
            </consumers>
        </channel>
        <channel>
            <video-mode>720p5000</video-mode>
            <consumers>
                <screen>
                    <device>2</device>
                </screen>
                <system-audio />
            </consumers>
        </channel>
    </channels>
    <controllers>
        <tcp>
            <port>5250</port>
            <protocol>AMCP</protocol>
        </tcp>
    </controllers>
    <amcp>
        <media-server>
            <host>localhost</host>
            <port>8000</port>
        </media-server>
    </amcp>

    <!-- ============================================================
         OSC ACTIV (in interiorul <configuration>, NU in comentariu).
         CasparCG trimite pozitia/durata fisierelor catre afisajul Timer.
         address = IP-ul PC-ului pe care ruleaza aplicatia Timer:
           - 127.0.0.1  daca Timer ruleaza pe ACELASI PC ca CasparCG
           - 192.168.1.131  daca ruleaza pe alt PC in retea (schimba IP-ul)
         port = 7250 (portul pe care asculta backend-ul Timer)
         ============================================================ -->
    <osc>
        <default-port>6250</default-port>
        <disable-send-to-amcp-clients>false</disable-send-to-amcp-clients>
        <predefined-clients>
            <predefined-client>
                <address>192.168.1.131</address>
                <port>7250</port>
            </predefined-client>
        </predefined-clients>
    </osc>
</configuration>
