[Unit]
Description=Timer CasparCG backend (OSC listener + WebSocket + serves React build)
After=network-online.target mongod.service
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/timer-caspar/backend
# Adjust the path to your Python (venv recommended)
ExecStart=/home/pi/timer-caspar/backend/venv/bin/uvicorn server:app --host 0.0.0.0 --port 8001
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
